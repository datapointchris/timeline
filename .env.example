# The container's environment, which docker compose reads. The server itself
# loads no .env, so `npm run dev` ignores this file. Copy it to .env (gitignored)
# for the local container. In production the host keeps its own copy, at the
# path docker-compose.yml names.

# HTTP listener
PORT=3000

# Application mode. "production" enables JSON logs and SPA static serving.
NODE_ENV=production

# SQLite database file path. Unset, it is data/timeline.db at the repo root. In
# the production image, /app/data is the bind-mounted volume.
DATABASE_PATH=/app/data/timeline.db

# Where Drizzle finds the migration SQL files. In the image these live at
# /app/migrations (top-level). In dev they live at server/migrations.
MIGRATIONS_FOLDER=/app/migrations

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Optional: where the production server reads the SPA static bundle from.
# Unset, it is client-dist two levels above server/dist/index.js, which in the
# Docker runtime image is /app/client-dist, where the image places client/dist.
# STATIC_DIR=/app/client-dist
